// ============================================================================
// KinderCRM Prisma schema
// PostgreSQL 16. Денежные поля — Decimal(12, 2) для точности.
// Используется индексирование по горячим путям. Партиционирование в будущем
// (Attendance, AuditLog) реализуется на уровне SQL-миграции.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE      // ходит сейчас
  ON_HOLD     // временно не ходит (отпуск/болезнь длительная)
  ARCHIVED    // выпустился / отчислен
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  SICK
  VACATION
}

/// Настроение ребёнка/ученика в дневнике (заметка учителя за день).
enum Mood {
  HAPPY
  NEUTRAL
  SAD
  SICK
}

/// Качество сна в детсаду / отдыха в школе.
enum NapQuality {
  GOOD
  NORMAL
  POOR
  NO_NAP
}

/// Тип оценки в школьном журнале.
enum GradeType {
  CLASSWORK      // работа на уроке
  HOMEWORK       // домашнее задание
  CONTROL        // контрольная работа
  EXAM           // экзамен
  PROJECT        // проект / реферат
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum ExpenseCategory {
  SALARIES        // зарплаты сотрудников
  TAXES           // налоги
  RENT            // аренда
  UTILITIES       // коммуналка
  FOOD            // питание
  TOYS            // игрушки и инвентарь
  STATIONERY      // канцелярия
  INTERNET        // интернет и связь
  CLEANING        // уборка и хозтовары
  REPAIRS         // ремонт
  EDUCATION       // учебные материалы
  OTHER
}

enum StaffPosition {
  TEACHER_ASSISTANT
  HEAD_MASTER
  METHODIST
  NURSE
  COOK
  PSYCHOLOGIST
  MUSIC_TEACHER
  GUARD
  CLEANER
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  TELEGRAM
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
}

// ---------------------------------------------------------------------------
// KINDERGARTEN (мульти-тенант: каждый садик = отдельный изолированный аккаунт)
// ---------------------------------------------------------------------------

/// Тип учреждения. По умолчанию KINDERGARTEN (для обратной совместимости
/// с существующими записями). SCHOOL включает школьные фичи: предметы,
/// уроки, оценки, домашние задания, журнал.
enum InstitutionType {
  KINDERGARTEN
  SCHOOL
}

model Kindergarten {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique  // короткий ID для URL/команд
  address       String?
  phone         String?
  isActive      Boolean  @default(true)

  /// Тип учреждения: садик или школа.
  /// Влияет на лейблы в UI (группа↔класс, ребёнок↔ученик) и доступные фичи.
  type          InstitutionType @default(KINDERGARTEN)

  /// API-ключ для внешнего терминала контроля доступа.
  /// Если задан — webhook /v1/time/webhook принимает события от устройства.
  terminalApiKey String? @unique

  /// Геолокация садика — для check-in валидации с телефона учителя.
  /// Если оба заданы, check-in через мобайл валидируется по расстоянию.
  latitude              Float?
  longitude             Float?
  /// Допустимый радиус check-in в метрах (по умолчанию 150 м).
  checkInRadiusMeters   Int     @default(150)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  groups        Group[]
  students      Student[]
  expenses      Expense[]
  extraIncomes  ExtraIncome[]
  staff         Staff[]
  menuItems     MenuItem[]
  subjects      Subject[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// MENU (питание)
// ---------------------------------------------------------------------------

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

model MenuItem {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  meal        MealType
  title       String
  description String?
  calories    Int?

  kindergartenId String
  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kindergartenId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// STAFF (сотрудники садика, не учителя — для них есть User с role=TEACHER)
// ---------------------------------------------------------------------------

model Staff {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  middleName   String?
  position     StaffPosition
  phone        String
  email        String?
  /// id группы, если сотрудник закреплён за группой (например, помощник воспитателя)
  groupId      String?
  salary       Decimal  @db.Decimal(12, 2) @default(0)
  hireDate     DateTime

  /// Связь с учёткой User, если сотрудник может входить в систему
  /// (например, воспитатель). Один к одному.
  userId       String?  @unique
  user         User?    @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)

  kindergartenId String
  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kindergartenId])
  @@index([position])
}

// ---------------------------------------------------------------------------
// USERS / AUTH
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          Role     @default(TEACHER)
  avatarUrl     String?
  phone         String?

  /// Для multi-tenant: к какому садику принадлежит пользователь.
  /// NULL = глобальный супер-админ, видит все садики.
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  /// Для TEACHER — id привязанной группы.
  /// (Может остаться NULL, пока админ не назначит группу.)
  groupId       String?
  group         Group?   @relation("GroupTeachers", fields: [groupId], references: [id], onDelete: SetNull)

  /// Для PARENT — id ребёнка.
  childId       String?
  child         Student? @relation(fields: [childId], references: [id])

  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?

  // ─── Time tracking (для TEACHER) ───────────────────────────────────
  /// Режим расчёта зарплаты: HOURLY (по часам) или FIXED (фиксированный оклад)
  salaryMode        SalaryMode @default(HOURLY)
  /// Ставка за час работы (для HOURLY)
  hourlyRate        Decimal?   @db.Decimal(10, 2)
  /// Фиксированный месячный оклад (для FIXED)
  monthlySalaryFixed Decimal?  @db.Decimal(12, 2)
  /// Норма часов в месяц (по умолчанию 176 = 8ч × 22 дня)
  workNorm          Int        @default(176)
  /// Биометрический дескриптор лица (Float32Array 128 значений) для Face ID
  faceDescriptor    Json?
  /// Код сотрудника на внешнем терминале контроля доступа (Hikvision/ZKTeco).
  /// По нему webhook сопоставляет событие с пользователем.
  terminalCode      String?    @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]      @relation("AuditActor")
  notifications Notification[]
  timeEntries   TimeEntry[]
  staffProfile  Staff?          @relation("StaffUser")
  diaryEntries  DiaryEntry[]    @relation("DiaryAuthor")
  kidNotes      KidNote[]       @relation("KidNoteAuthor")
  gradesGiven   Grade[]         @relation("GradeAuthor")
  homeworkSet   Homework[]      @relation("HomeworkAuthor")

  @@index([role])
  @@index([groupId])
  @@index([kindergartenId])
}

enum SalaryMode {
  HOURLY
  FIXED
}

enum TimeVerifyMethod {
  MANUAL
  FACE
  PIN
  QR
  TERMINAL // событие от внешнего терминала контроля доступа
}

/// Запись прихода/ухода учителя на работу.
/// При checkOut вычисляется minutesWorked и закрепляется до правки.
model TimeEntry {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Дата (для индексации и группировки по дням)
  date            DateTime         @db.Date
  /// Когда зашёл на работу
  checkIn         DateTime
  /// Когда вышел (NULL пока работает)
  checkOut        DateTime?
  /// Сколько отработал минут (заполняется при checkOut)
  minutesWorked   Int?
  /// Как подтверждена отметка
  verifyMethod    TimeVerifyMethod @default(MANUAL)
  /// Опциональный комментарий («больничный», «перерыв удлинён»)
  note            String?
  /// Если запись правил админ, фиксируем
  editedByAdminId String?

  /// GPS-координаты, откуда был сделан check-in (если с мобайла).
  /// Используются для аудита и валидации геофенсинга.
  checkInLat      Float?
  checkInLon      Float?
  /// Расстояние от точки садика в метрах (на момент check-in)
  distanceMeters  Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([date])
}

/// Refresh-токены хранятся в БД, чтобы их можно было отзывать.
/// `tokenHash` — sha256 от самого токена, сам токен не сохраняем.
model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  jti        String   @unique
  tokenHash  String
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// GROUPS
// ---------------------------------------------------------------------------

model Group {
  id                   String   @id @default(cuid())
  name                 String
  /// Возрастной диапазон (для садика). Школа использует gradeLabel/gradeNumber.
  ageRange             String         // "3–4 года" в саду, в школе можно "10–11 лет" или пусто
  /// Школьный лейбл класса: "5А", "11Б". NULL для садика.
  gradeLabel           String?
  /// Параллель (5, 11) — для агрегаций «5-е классы». NULL для садика.
  gradeNumber          Int?
  capacity             Int      @default(20)
  monthlyFee           Decimal  @db.Decimal(12, 2) @default(0)
  /// Фикс. ежемесячные расходы на группу (питание, материалы и т.п.)
  fixedMonthlyExpense  Decimal  @db.Decimal(12, 2) @default(0)
  color                String   @default("#6366f1")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  /// Multi-tenant: к какому садику принадлежит группа
  kindergartenId       String?
  kindergarten         Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  students             Student[]
  teachers             User[]          @relation("GroupTeachers")
  schedule             ScheduleItem[]
  expenses             Expense[]
  extraIncomes         ExtraIncome[]
  attendance           Attendance[]
  salaries             Salary[]
  monthlyReports       MonthlyReport[]
  meetings             Meeting[]
  diary                DiaryEntry[]
  homework             Homework[]

  @@index([isActive])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// STUDENTS (Дети)
// ---------------------------------------------------------------------------

model Student {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  middleName    String?
  birthDate     DateTime
  gender        Gender
  photoUrl      String?
  medicalNotes  String?
  notes         String?

  // Родители
  motherName    String?
  motherPhone   String?
  fatherName    String?
  fatherPhone   String?
  address       String?
  extraContact  String?
  telegram      String?
  whatsapp      String?

  /// Индивидуальная плата (если не задано — берётся из group.monthlyFee).
  monthlyFee    Decimal? @db.Decimal(12, 2)

  status        StudentStatus @default(ACTIVE)
  enrolledAt    DateTime      @default(now())
  archivedAt    DateTime?

  groupId       String
  group         Group         @relation(fields: [groupId], references: [id])

  /// Multi-tenant: к какому садику принадлежит ребёнок
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  attendance    Attendance[]
  payments      Payment[]
  parents       User[]        // PARENT-аккаунты, привязанные к ребёнку
  kidNotes      KidNote[]
  grades        Grade[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([groupId])
  @@index([status])
  @@index([lastName, firstName])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// SCHEDULE
// ---------------------------------------------------------------------------

model ScheduleItem {
  id         String   @id @default(cuid())
  groupId    String
  dayOfWeek  Int      // 1..7 (Mon..Sun)
  startTime  String   // "HH:mm"
  endTime    String
  /// Для садика — название активности (лепка, музыка, прогулка).
  /// Для школы — название предмета (если subjectId не задан) или подтверждение.
  activity   String
  /// Опционально — предмет (для школы). Если задан, activity дублирует subject.name для удобства.
  subjectId  String?
  /// Опционально — конкретный учитель, ведущий этот урок.
  teacherId  String?
  /// Кабинет: "304", "Физкультурный зал".
  room       String?
  createdAt  DateTime @default(now())

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([groupId, dayOfWeek])
  @@index([subjectId])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// ATTENDANCE
// ---------------------------------------------------------------------------

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  groupId    String            // денормализуем для быстрых запросов по группе
  date       DateTime          @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?           // id пользователя, который отметил
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      Group             @relation(fields: [groupId], references: [id])

  @@unique([studentId, date])
  @@index([groupId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// PAYMENTS (доход от родителей)
// ---------------------------------------------------------------------------

model Payment {
  id         String         @id @default(cuid())
  studentId  String
  month      String         // "YYYY-MM"
  amount     Decimal        @db.Decimal(12, 2)
  paid       Boolean        @default(false)
  paidAt     DateTime?
  method     PaymentMethod?
  comment    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, month])
  @@index([month, paid])
}

// ---------------------------------------------------------------------------
// EXTRA INCOME (доп. услуги, кружки, утренники)
// ---------------------------------------------------------------------------

model ExtraIncome {
  id        String   @id @default(cuid())
  title     String
  amount    Decimal  @db.Decimal(12, 2)
  month     String
  groupId   String?
  comment   String?
  createdAt DateTime @default(now())

  group     Group?   @relation(fields: [groupId], references: [id])

  /// Multi-tenant
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  @@index([month])
  @@index([groupId, month])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// EXPENSES
// ---------------------------------------------------------------------------

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  month       String
  groupId     String?         // NULL = общий расход (распределяется пропорционально детям)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  group       Group?          @relation(fields: [groupId], references: [id])

  /// Multi-tenant
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  @@index([month])
  @@index([groupId, month])
  @@index([month, category])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// SALARIES
// ---------------------------------------------------------------------------

model Salary {
  id         String   @id @default(cuid())
  teacherId  String
  groupId    String?
  month      String
  amount     Decimal  @db.Decimal(12, 2)
  paid       Boolean  @default(false)
  paidAt     DateTime?
  comment    String?
  createdAt  DateTime @default(now())

  group      Group?   @relation(fields: [groupId], references: [id])

  @@unique([teacherId, month])
  @@index([month])
}

// ---------------------------------------------------------------------------
// MONTHLY REPORT (агрегированные итоги по группе — кэш на уровне БД)
// ---------------------------------------------------------------------------

model MonthlyReport {
  id            String   @id @default(cuid())
  groupId       String
  month         String
  studentsCount Int
  paidCount     Int
  debtorsCount  Int
  income        Decimal  @db.Decimal(14, 2)
  expenses      Decimal  @db.Decimal(14, 2)
  profit        Decimal  @db.Decimal(14, 2)
  margin        Decimal  @db.Decimal(6, 4)   // -1..1
  attendanceRate Decimal @db.Decimal(5, 4)   // 0..1
  generatedAt   DateTime @default(now())

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, month])
  @@index([month])
}

// ---------------------------------------------------------------------------
// MEETINGS (родительские собрания)
// ---------------------------------------------------------------------------

model Meeting {
  id          String   @id @default(cuid())
  groupId     String
  title       String
  scheduledAt DateTime           // дата и время проведения
  location    String?            // место/кабинет
  description String?            // повестка
  createdById String?            // user.id создателя (учитель/админ)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, scheduledAt])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// PHONE → TELEGRAM CHAT LINKS (привязка телефонов родителей к Telegram чатам)
// ---------------------------------------------------------------------------

model PhoneChatLink {
  id            String   @id @default(cuid())
  /// Нормализованный номер телефона (только цифры, без + и пробелов)
  phoneNormalized String @unique
  /// Telegram chat ID родителя
  chatId        BigInt
  /// Имя/фамилия из профиля Telegram (для отладки)
  fullName      String?
  username      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chatId])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model Notification {
  id          String              @id @default(cuid())
  userId      String?
  title       String
  description String?
  type        NotificationType    @default(INFO)
  channel     NotificationChannel @default(IN_APP)
  read        Boolean             @default(false)
  payload     Json?
  createdAt   DateTime            @default(now())

  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?
  action    AuditAction
  entity    String      // "Student", "Group", …
  entityId  String?
  diff      Json?       // {before, after}
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  actor     User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// DIARY (электронный дневник для садика/школы)
// ---------------------------------------------------------------------------

/// Запись дневника группы на день. Одна на (group, date).
/// Учитель заполняет в конце дня; родители видят.
model DiaryEntry {
  id          String   @id @default(cuid())
  groupId     String
  date        DateTime @db.Date
  // Меню дня
  breakfast   String?
  lunch       String?
  snack       String?
  // Чем занимались
  activities  String?
  // Общая заметка от учителя на группу
  note        String?
  // Автор записи
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author      User  @relation("DiaryAuthor", fields: [authorId], references: [id])

  @@unique([groupId, date])
  @@index([groupId])
  @@index([date])
}

/// Заметка о конкретном ученике на день. Одна на (student, date).
/// Учитель пишет, родитель видит только своего ребёнка.
model KidNote {
  id          String      @id @default(cuid())
  studentId   String
  date        DateTime    @db.Date
  mood        Mood?
  napQuality  NapQuality?
  note        String?
  photoUrls   String[]    @default([])
  authorId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author      User    @relation("KidNoteAuthor", fields: [authorId], references: [id])

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// SCHOOL: SUBJECTS / GRADES / HOMEWORK
// ---------------------------------------------------------------------------

/// Учебный предмет (только для школы). Зависит от Kindergarten (institution).
model Subject {
  id              String   @id @default(cuid())
  name            String   // "Математика", "Физика"
  color           String   @default("#4FB286") // для UI

  /// Multi-tenant — к какой школе/садику принадлежит предмет.
  kindergartenId  String?
  kindergarten    Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons         ScheduleItem[]
  grades          Grade[]
  homework        Homework[]

  @@unique([kindergartenId, name])
  @@index([kindergartenId])
}

/// Оценка, выставленная учеником по предмету.
model Grade {
  id          String     @id @default(cuid())
  studentId   String
  subjectId   String
  /// Шкала 5-балльная (или 10-балльная — хранится числом, UI рендерит как нужно)
  value       Int
  type        GradeType  @default(CLASSWORK)
  /// Дата оценки (день урока)
  date        DateTime   @db.Date
  comment     String?
  /// Автор (учитель)
  authorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author      User       @relation("GradeAuthor", fields: [authorId], references: [id])

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, subjectId, date])
  @@index([date])
}

/// Домашнее задание. Одно ДЗ на (subject, group, dueDate), видно всему классу.
model Homework {
  id          String   @id @default(cuid())
  subjectId   String
  groupId     String   // класс, которому задано
  title       String
  description String?
  /// Дата к которой нужно выполнить
  dueDate     DateTime @db.Date
  /// Ссылки на файлы/изображения
  attachments String[] @default([])
  /// Автор
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author      User    @relation("HomeworkAuthor", fields: [authorId], references: [id])

  @@index([groupId, dueDate])
  @@index([subjectId])
}

