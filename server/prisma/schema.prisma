// ============================================================================
// KinderCRM Prisma schema
// PostgreSQL 16. Денежные поля — Decimal(12, 2) для точности.
// Используется индексирование по горячим путям. Партиционирование в будущем
// (Attendance, AuditLog) реализуется на уровне SQL-миграции.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  /// Ученик школы со своим входом (кабинет ученика). Привязан к Student через User.studentId.
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE      // ходит сейчас
  ON_HOLD     // временно не ходит (отпуск/болезнь длительная)
  ARCHIVED    // выпустился / отчислен
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  SICK
  VACATION
}

/// Настроение ребёнка/ученика в дневнике (заметка учителя за день).
enum Mood {
  HAPPY
  NEUTRAL
  SAD
  SICK
}

/// Качество сна в детсаду / отдыха в школе.
enum NapQuality {
  GOOD
  NORMAL
  POOR
  NO_NAP
}

/// Тип оценки в школьном журнале.
enum GradeType {
  CLASSWORK      // работа на уроке
  HOMEWORK       // домашнее задание
  CONTROL        // контрольная работа
  EXAM           // экзамен
  PROJECT        // проект / реферат
  OTHER
}

/// Тип учебного периода (для школы).
enum TermType {
  QUARTER    // четверть
  TRIMESTER  // триместр
  SEMESTER   // полугодие
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum ExpenseCategory {
  SALARIES        // зарплаты сотрудников
  TAXES           // налоги
  RENT            // аренда
  UTILITIES       // коммуналка
  FOOD            // питание
  TOYS            // игрушки и инвентарь
  STATIONERY      // канцелярия
  INTERNET        // интернет и связь
  CLEANING        // уборка и хозтовары
  REPAIRS         // ремонт
  EDUCATION       // учебные материалы
  OTHER
}

enum StaffPosition {
  TEACHER_ASSISTANT
  HEAD_MASTER
  METHODIST
  NURSE
  COOK
  PSYCHOLOGIST
  MUSIC_TEACHER
  GUARD
  CLEANER
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  TELEGRAM
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
}

// ---------------------------------------------------------------------------
// KINDERGARTEN (мульти-тенант: каждый садик = отдельный изолированный аккаунт)
// ---------------------------------------------------------------------------

/// Тип учреждения. Платформа только для школ: все учреждения — SCHOOL.
/// KINDERGARTEN оставлен в enum лишь для обратной совместимости (убирать
/// значение из enum в Postgres больно); в коде не используется.
/// Модель называется Kindergarten по историческим причинам — это ШКОЛА
/// (тенант платформы); переименование в School — отдельная большая миграция.
enum InstitutionType {
  KINDERGARTEN
  SCHOOL
}

model Kindergarten {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique  // короткий ID для URL/команд
  address       String?
  phone         String?
  isActive      Boolean  @default(true)

  /// Демо-учреждение: «живое демо» для лендинга. Вход через
  /// POST /auth/demo-login; данные доступны только для просмотра
  /// (мутации блокируются DemoReadOnlyGuard).
  isDemo        Boolean  @default(false)

  /// Тип учреждения: садик или школа.
  /// Влияет на лейблы в UI (группа↔класс, ребёнок↔ученик) и доступные фичи.
  type          InstitutionType @default(SCHOOL)

  /// API-ключ для внешнего терминала контроля доступа.
  /// Если задан — webhook /v1/time/webhook принимает события от устройства.
  terminalApiKey String? @unique

  /// Геолокация садика — для check-in валидации с телефона учителя.
  /// Если оба заданы, check-in через мобайл валидируется по расстоянию.
  latitude              Float?
  longitude             Float?
  /// Допустимый радиус check-in в метрах (по умолчанию 150 м).
  checkInRadiusMeters   Int     @default(150)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  groups        Group[]
  students      Student[]
  expenses      Expense[]
  extraIncomes  ExtraIncome[]
  staff         Staff[]
  menuItems     MenuItem[]
  subjects      Subject[]
  terms         Term[]
  features      KindergartenFeature[]
  libraryItems  LibraryItem[]
  examTracks    ExamTrack[]
  quizzes       Quiz[]
  storedFiles     StoredFile[]
  lessonMaterials LessonMaterial[]

  @@index([isActive])
}

/// Переопределение раздела (feature) для конкретного учреждения.
/// Нет записи → действует значение по умолчанию из реестра разделов
/// (server/src/modules/features/feature-registry.ts). Управляет владелец платформы.
model KindergartenFeature {
  id             String   @id @default(cuid())
  kindergartenId String
  /// Ключ раздела из реестра: 'grades', 'payments', 'analytics', ...
  key            String
  enabled        Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  @@unique([kindergartenId, key])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// MENU (питание)
// ---------------------------------------------------------------------------

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

model MenuItem {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  meal        MealType
  title       String
  description String?
  calories    Int?

  kindergartenId String
  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kindergartenId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// STAFF (сотрудники садика, не учителя — для них есть User с role=TEACHER)
// ---------------------------------------------------------------------------

model Staff {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  middleName   String?
  position     StaffPosition
  phone        String
  email        String?
  /// id группы, если сотрудник закреплён за группой (например, помощник воспитателя)
  groupId      String?
  salary       Decimal  @db.Decimal(12, 2) @default(0)
  hireDate     DateTime

  /// Связь с учёткой User, если сотрудник может входить в систему
  /// (например, воспитатель). Один к одному.
  userId       String?  @unique
  user         User?    @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)

  kindergartenId String
  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kindergartenId])
  @@index([position])
}

// ---------------------------------------------------------------------------
// USERS / AUTH
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          Role     @default(TEACHER)
  avatarUrl     String?
  phone         String?

  /// Для multi-tenant: к какому садику принадлежит пользователь.
  /// NULL = глобальный супер-админ, видит все садики.
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  /// Для TEACHER — id основной (домашней) группы.
  /// (Может остаться NULL, пока админ не назначит группу.)
  groupId       String?
  group         Group?   @relation("GroupTeachers", fields: [groupId], references: [id], onDelete: SetNull)

  /// Для TEACHER — все классы, которые он ведёт (many-to-many).
  /// Учитель может преподавать в нескольких классах; основная группа выше —
  /// одна из них (для совместимости со старой логикой посещаемости и т.п.).
  teachingGroups Group[]  @relation("TeacherClasses")
  /// Предметы, которые админ открыл учителю в журнале и ДЗ (M:N).
  teachingSubjects Subject[] @relation("TeacherSubjects")

  /// Для PARENT — id ребёнка.
  childId       String?
  child         Student? @relation(fields: [childId], references: [id])

  /// Для STUDENT — ученик, чей это аккаунт (один аккаунт на ученика).
  studentId     String?  @unique
  student       Student? @relation("StudentAccount", fields: [studentId], references: [id], onDelete: SetNull)
  /// Для STUDENT: версия личной ссылки входа. null — ссылки нет; выдача = 1, перевыпуск = +1.
  /// Сама ссылка нигде не хранится: она подписывается (HMAC) от id и версии, поэтому
  /// её можно показать снова, а перевыпуск мгновенно убивает старую.
  linkVersion   Int?
  /// Для STUDENT: когда классный руководитель выдал логин и пароль. null — пароль не выдан, вход только по ссылке.
  passwordIssuedAt DateTime?

  /// Админ выдал временный пароль — при первом входе его обязательно сменить.
  mustChangePassword Boolean @default(false)

  /// Классы, где пользователь — классный руководитель.
  homeroomGroups Group[] @relation("Homeroom")
  /// Статусы ДЗ, выставленные этим пользователем (учитель или сам ученик).
  homeworkMarks HomeworkSubmission[] @relation("SubmissionMarker")
  /// Материалы библиотеки, квизы и направления подготовки, созданные пользователем.
  libraryItems  LibraryItem[] @relation("LibraryAuthor")
  quizzesAuthored Quiz[]      @relation("QuizAuthor")
  examTracksAuthored ExamTrack[] @relation("ExamTrackAuthor")
  /// Загруженные файлы и материалы к уроку (при удалении учителя остаются, authorId → null).
  uploadedFiles   StoredFile[]    @relation("FileUploader")
  lessonMaterialsAuthored LessonMaterial[] @relation("LessonMaterialAuthor")

  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?

  // ─── Time tracking (для TEACHER) ───────────────────────────────────
  /// Режим расчёта зарплаты: HOURLY (по часам) или FIXED (фиксированный оклад)
  salaryMode        SalaryMode @default(HOURLY)
  /// Ставка за час работы (для HOURLY)
  hourlyRate        Decimal?   @db.Decimal(10, 2)
  /// Фиксированный месячный оклад (для FIXED)
  monthlySalaryFixed Decimal?  @db.Decimal(12, 2)
  /// Норма часов в месяц (по умолчанию 176 = 8ч × 22 дня)
  workNorm          Int        @default(176)
  /// Биометрический дескриптор лица (Float32Array 128 значений) для Face ID
  faceDescriptor    Json?
  /// Код сотрудника на внешнем терминале контроля доступа (Hikvision/ZKTeco).
  /// По нему webhook сопоставляет событие с пользователем.
  terminalCode      String?    @unique

  /// Expo push token мобильного устройства (для push-уведомлений).
  /// Обновляется при каждом логине из мобайла.
  expoPushToken     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  passwordTokens PasswordToken[]
  auditLogs     AuditLog[]      @relation("AuditActor")
  notifications Notification[]
  timeEntries   TimeEntry[]
  staffProfile  Staff?          @relation("StaffUser")
  diaryEntries  DiaryEntry[]    @relation("DiaryAuthor")
  kidNotes      KidNote[]       @relation("KidNoteAuthor")
  gradesGiven   Grade[]         @relation("GradeAuthor")
  homeworkSet   Homework[]      @relation("HomeworkAuthor")
  conversations Conversation[]  @relation("ParentConversations")
  sentMessages  Message[]       @relation("SentMessages")

  @@index([role])
  @@index([groupId])
  @@index([kindergartenId])
}

enum SalaryMode {
  HOURLY
  FIXED
}

enum TimeVerifyMethod {
  MANUAL
  FACE
  PIN
  QR
  TERMINAL // событие от внешнего терминала контроля доступа
}

/// Запись прихода/ухода учителя на работу.
/// При checkOut вычисляется minutesWorked и закрепляется до правки.
model TimeEntry {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Дата (для индексации и группировки по дням)
  date            DateTime         @db.Date
  /// Когда зашёл на работу
  checkIn         DateTime
  /// Когда вышел (NULL пока работает)
  checkOut        DateTime?
  /// Сколько отработал минут (заполняется при checkOut)
  minutesWorked   Int?
  /// Как подтверждена отметка
  verifyMethod    TimeVerifyMethod @default(MANUAL)
  /// Опциональный комментарий («больничный», «перерыв удлинён»)
  note            String?
  /// Если запись правил админ, фиксируем
  editedByAdminId String?

  /// GPS-координаты, откуда был сделан check-in (если с мобайла).
  /// Используются для аудита и валидации геофенсинга.
  checkInLat      Float?
  checkInLon      Float?
  /// Расстояние от точки садика в метрах (на момент check-in)
  distanceMeters  Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([date])
}

/// Refresh-токены хранятся в БД, чтобы их можно было отзывать.
/// `tokenHash` — sha256 от самого токена, сам токен не сохраняем.
model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  jti        String   @unique
  tokenHash  String
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Зачем выдан одноразовый токен для установки пароля.
enum PasswordTokenPurpose {
  /// Приглашение: новый пользователь сам задаёт пароль по ссылке из письма.
  INVITE
  /// Восстановление: «Забыли пароль?».
  RESET
}

/// Одноразовые ссылки «задать пароль» из писем. Сам токен нигде не хранится —
/// только sha256 (как у RefreshToken); использованный токен гасится usedAt.
model PasswordToken {
  id        String               @id @default(cuid())
  userId    String
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// GROUPS
// ---------------------------------------------------------------------------

model Group {
  id                   String   @id @default(cuid())
  name                 String
  /// Возрастной диапазон (для садика). Школа использует gradeLabel/gradeNumber.
  ageRange             String         // "3–4 года" в саду, в школе можно "10–11 лет" или пусто
  /// Школьный лейбл класса: "5А", "11Б". NULL для садика.
  gradeLabel           String?
  /// Параллель (5, 11) — для агрегаций «5-е классы». NULL для садика.
  gradeNumber          Int?
  capacity             Int      @default(20)
  monthlyFee           Decimal  @db.Decimal(12, 2) @default(0)
  /// Фикс. ежемесячные расходы на группу (питание, материалы и т.п.)
  fixedMonthlyExpense  Decimal  @db.Decimal(12, 2) @default(0)
  color                String   @default("#6366f1")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  /// Multi-tenant: к какому садику принадлежит группа
  kindergartenId       String?
  kindergarten         Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  /// Классный руководитель (учитель этого класса с расширенными правами:
  /// сводка по классу, связь с родителями). Не больше одного на класс.
  homeroomTeacherId    String?
  homeroomTeacher      User?    @relation("Homeroom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  students             Student[]
  teachers             User[]          @relation("GroupTeachers")
  /// Учителя, ведущие этот класс (many-to-many, помимо основного teacher).
  teachingTeachers     User[]          @relation("TeacherClasses")
  schedule             ScheduleItem[]
  expenses             Expense[]
  extraIncomes         ExtraIncome[]
  attendance           Attendance[]
  salaries             Salary[]
  monthlyReports       MonthlyReport[]
  meetings             Meeting[]
  diary                DiaryEntry[]
  homework             Homework[]
  conversations        Conversation[]
  lessonMaterials      LessonMaterial[]

  @@index([isActive])
  @@index([kindergartenId])
  @@index([homeroomTeacherId])
}

// ---------------------------------------------------------------------------
// STUDENTS (Дети)
// ---------------------------------------------------------------------------

model Student {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  middleName    String?
  birthDate     DateTime
  gender        Gender
  photoUrl      String?
  medicalNotes  String?
  notes         String?

  // Родители
  motherName    String?
  motherPhone   String?
  fatherName    String?
  fatherPhone   String?
  address       String?
  extraContact  String?
  telegram      String?
  whatsapp      String?

  /// Индивидуальная плата (если не задано — берётся из group.monthlyFee).
  monthlyFee    Decimal? @db.Decimal(12, 2)

  status        StudentStatus @default(ACTIVE)
  enrolledAt    DateTime      @default(now())
  archivedAt    DateTime?

  groupId       String
  group         Group         @relation(fields: [groupId], references: [id])

  /// Multi-tenant: к какому садику принадлежит ребёнок
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  attendance    Attendance[]
  payments      Payment[]
  parents       User[]        // PARENT-аккаунты, привязанные к ребёнку
  /// Собственный вход ученика (роль STUDENT). Не больше одного.
  account       User?         @relation("StudentAccount")
  kidNotes      KidNote[]
  grades        Grade[]
  homeworkSubmissions HomeworkSubmission[]
  quizAttempts  QuizAttempt[]
  gameScores    GameScore[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([groupId])
  @@index([status])
  @@index([lastName, firstName])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// SCHEDULE
// ---------------------------------------------------------------------------

model ScheduleItem {
  id         String   @id @default(cuid())
  groupId    String
  dayOfWeek  Int      // 1..7 (Mon..Sun)
  startTime  String   // "HH:mm"
  endTime    String
  /// Для садика — название активности (лепка, музыка, прогулка).
  /// Для школы — название предмета (если subjectId не задан) или подтверждение.
  activity   String
  /// Опционально — предмет (для школы). Если задан, activity дублирует subject.name для удобства.
  subjectId  String?
  /// Опционально — конкретный учитель, ведущий этот урок.
  teacherId  String?
  /// Кабинет: "304", "Физкультурный зал".
  room       String?
  createdAt  DateTime @default(now())

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([groupId, dayOfWeek])
  @@index([subjectId])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// ATTENDANCE
// ---------------------------------------------------------------------------

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  groupId    String            // денормализуем для быстрых запросов по группе
  date       DateTime          @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?           // id пользователя, который отметил
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      Group             @relation(fields: [groupId], references: [id])

  @@unique([studentId, date])
  @@index([groupId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// PAYMENTS (доход от родителей)
// ---------------------------------------------------------------------------

model Payment {
  id         String         @id @default(cuid())
  studentId  String
  month      String         // "YYYY-MM"
  amount     Decimal        @db.Decimal(12, 2)
  paid       Boolean        @default(false)
  paidAt     DateTime?
  method     PaymentMethod?
  comment    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, month])
  @@index([month, paid])
}

// ---------------------------------------------------------------------------
// EXTRA INCOME (доп. услуги, кружки, утренники)
// ---------------------------------------------------------------------------

model ExtraIncome {
  id        String   @id @default(cuid())
  title     String
  amount    Decimal  @db.Decimal(12, 2)
  month     String
  groupId   String?
  comment   String?
  createdAt DateTime @default(now())

  group     Group?   @relation(fields: [groupId], references: [id])

  /// Multi-tenant
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  @@index([month])
  @@index([groupId, month])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// EXPENSES
// ---------------------------------------------------------------------------

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  month       String
  groupId     String?         // NULL = общий расход (распределяется пропорционально детям)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  group       Group?          @relation(fields: [groupId], references: [id])

  /// Multi-tenant
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  @@index([month])
  @@index([groupId, month])
  @@index([month, category])
  @@index([kindergartenId])
}

// ---------------------------------------------------------------------------
// SALARIES
// ---------------------------------------------------------------------------

model Salary {
  id         String   @id @default(cuid())
  teacherId  String
  groupId    String?
  month      String
  amount     Decimal  @db.Decimal(12, 2)
  paid       Boolean  @default(false)
  paidAt     DateTime?
  comment    String?
  createdAt  DateTime @default(now())

  group      Group?   @relation(fields: [groupId], references: [id])

  @@unique([teacherId, month])
  @@index([month])
}

// ---------------------------------------------------------------------------
// MONTHLY REPORT (агрегированные итоги по группе — кэш на уровне БД)
// ---------------------------------------------------------------------------

model MonthlyReport {
  id            String   @id @default(cuid())
  groupId       String
  month         String
  studentsCount Int
  paidCount     Int
  debtorsCount  Int
  income        Decimal  @db.Decimal(14, 2)
  expenses      Decimal  @db.Decimal(14, 2)
  profit        Decimal  @db.Decimal(14, 2)
  margin        Decimal  @db.Decimal(6, 4)   // -1..1
  attendanceRate Decimal @db.Decimal(5, 4)   // 0..1
  generatedAt   DateTime @default(now())

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, month])
  @@index([month])
}

// ---------------------------------------------------------------------------
// MEETINGS (родительские собрания)
// ---------------------------------------------------------------------------

model Meeting {
  id          String   @id @default(cuid())
  groupId     String
  title       String
  scheduledAt DateTime           // дата и время проведения
  location    String?            // место/кабинет
  description String?            // повестка
  createdById String?            // user.id создателя (учитель/админ)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, scheduledAt])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// PHONE → TELEGRAM CHAT LINKS (привязка телефонов родителей к Telegram чатам)
// ---------------------------------------------------------------------------

model PhoneChatLink {
  id            String   @id @default(cuid())
  /// Нормализованный номер телефона (только цифры, без + и пробелов)
  phoneNormalized String @unique
  /// Telegram chat ID родителя
  chatId        BigInt
  /// Имя/фамилия из профиля Telegram (для отладки)
  fullName      String?
  username      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chatId])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model Notification {
  id          String              @id @default(cuid())
  userId      String?
  title       String
  description String?
  type        NotificationType    @default(INFO)
  channel     NotificationChannel @default(IN_APP)
  read        Boolean             @default(false)
  payload     Json?
  createdAt   DateTime            @default(now())

  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?
  action    AuditAction
  entity    String      // "Student", "Group", …
  entityId  String?
  diff      Json?       // {before, after}
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  actor     User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// DIARY (электронный дневник для садика/школы)
// ---------------------------------------------------------------------------

/// Запись дневника группы на день. Одна на (group, date).
/// Учитель заполняет в конце дня; родители видят.
model DiaryEntry {
  id          String   @id @default(cuid())
  groupId     String
  date        DateTime @db.Date
  // Меню дня
  breakfast   String?
  lunch       String?
  snack       String?
  // Чем занимались
  activities  String?
  // Общая заметка от учителя на группу
  note        String?
  // Автор записи
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author      User  @relation("DiaryAuthor", fields: [authorId], references: [id])

  @@unique([groupId, date])
  @@index([groupId])
  @@index([date])
}

/// Заметка о конкретном ученике на день. Одна на (student, date).
/// Учитель пишет, родитель видит только своего ребёнка.
model KidNote {
  id          String      @id @default(cuid())
  studentId   String
  date        DateTime    @db.Date
  mood        Mood?
  napQuality  NapQuality?
  note        String?
  photoUrls   String[]    @default([])
  authorId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author      User    @relation("KidNoteAuthor", fields: [authorId], references: [id])

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// SCHOOL: SUBJECTS / GRADES / HOMEWORK
// ---------------------------------------------------------------------------

/// Учебный предмет (только для школы). Зависит от Kindergarten (institution).
model Subject {
  id              String   @id @default(cuid())
  name            String   // "Математика", "Физика"
  color           String   @default("#4FB286") // для UI

  /// Multi-tenant — к какой школе/садику принадлежит предмет.
  kindergartenId  String?
  kindergarten    Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons         ScheduleItem[]
  grades          Grade[]
  homework        Homework[]
  libraryItems    LibraryItem[]
  quizzes         Quiz[]
  lessonMaterials LessonMaterial[]
  /// Учителя, которым открыт этот предмет.
  teachers        User[]   @relation("TeacherSubjects")

  @@unique([kindergartenId, name])
  @@index([kindergartenId])
}

/// Оценка, выставленная учеником по предмету.
model Grade {
  id          String     @id @default(cuid())
  studentId   String
  subjectId   String
  /// Шкала 5-балльная (или 10-балльная — хранится числом, UI рендерит как нужно)
  value       Int
  type        GradeType  @default(CLASSWORK)
  /// Дата оценки (день урока)
  date        DateTime   @db.Date
  comment     String?
  /// Автор (учитель)
  authorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author      User       @relation("GradeAuthor", fields: [authorId], references: [id])

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, subjectId, date])
  @@index([date])
}

/// Домашнее задание. Одно ДЗ на (subject, group, dueDate), видно всему классу.
model Homework {
  id          String   @id @default(cuid())
  subjectId   String
  groupId     String   // класс, которому задано
  title       String
  description String?
  /// Дата к которой нужно выполнить
  dueDate     DateTime @db.Date
  /// Ссылки на файлы/изображения
  attachments String[] @default([])
  /// Автор
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author      User    @relation("HomeworkAuthor", fields: [authorId], references: [id])
  submissions HomeworkSubmission[]

  @@index([groupId, dueDate])
  @@index([subjectId])
}

/// Как ученик выполнил конкретное ДЗ. Нет записи = ещё не отмечено.
enum SubmissionStatus {
  SUBMITTED  // ученик сам отметил «сделал», учитель ещё не проверил
  DONE       // учитель подтвердил: выполнено
  PARTIAL    // выполнено частично
  NOT_DONE   // не выполнено
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  studentId   String
  status      SubmissionStatus
  /// Комментарий учителя («нет второй задачи», «молодец»).
  comment     String?
  /// Кто выставил последний статус: сам ученик или учитель.
  markedById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy    User?    @relation("SubmissionMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId, status])
}

/// Учебный период школы (четверть / триместр / полугодие).
/// Оценки группируются по нему через диапазон дат (startDate..endDate).
model Term {
  id              String   @id @default(cuid())
  name            String   // "1 четверть"
  type            TermType @default(QUARTER)
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date

  kindergartenId  String?
  kindergarten    Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kindergartenId, startDate])
}

// ---------------------------------------------------------------------------
// CHAT (родитель ↔ учитель/админ)
// ---------------------------------------------------------------------------

/// Канал переписки:
///   GENERAL — родитель ↔ учитель (+админ): учёба, быт. Учитель ВИДИТ.
///   ADMIN   — родитель ↔ администрация: оплата, финансы. Учитель НЕ видит.
enum ConversationScope {
  GENERAL
  ADMIN
}

/// Тип сообщения — для отрисовки (обычное / карточка оплаты).
enum MessageKind {
  TEXT
  PAYMENT
}

/// Переписка: одна на (группа/класс, родитель, канал).
model Conversation {
  id              String   @id @default(cuid())
  groupId         String
  parentId        String
  scope           ConversationScope @default(GENERAL)
  kindergartenId  String?
  lastMessageAt   DateTime @default(now())
  /// Когда родитель / сотрудник в последний раз открывал — для подсчёта непрочитанного
  parentReadAt    DateTime?
  staffReadAt     DateTime?
  createdAt       DateTime @default(now())

  group           Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent          User  @relation("ParentConversations", fields: [parentId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([groupId, parentId, scope])
  @@index([groupId, lastMessageAt])
  @@index([parentId])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  text            String
  kind            MessageKind @default(TEXT)
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// LEARNING: библиотека, квизы, подготовка к экзаменам, игры (этап 3)
// ---------------------------------------------------------------------------

enum LibraryItemType {
  BOOK
  ARTICLE
  VIDEO
  AUDIO
  LINK
}

/// Материал библиотеки школы. Файлы не храним — только ссылка на материал.
model LibraryItem {
  id             String   @id @default(cuid())
  kindergartenId String
  title          String
  description    String?
  type           LibraryItemType @default(LINK)
  /// Ссылка на материал. null — материал хранится файлом (fileId).
  url            String?
  /// Загруженный файл (хранится вне базы, см. StoredFile). Либо url, либо fileId.
  fileId         String?
  subjectId      String?
  /// Параллель (5, 6…), если материал для конкретных классов; null — для всех.
  gradeNumber    Int?
  /// Автор. При удалении учителя материал остаётся (authorId → null).
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  author         User?        @relation("LibraryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  file           StoredFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([kindergartenId, createdAt])
  @@index([subjectId])
  @@index([fileId])
}

/// Загруженный файл. Сам файл лежит в хранилище (диск / S3), в базе только запись:
/// так база остаётся лёгкой. Загрузка без привязки к материалу (attached = false)
/// удаляется ночной чисткой через сутки.
model StoredFile {
  id             String   @id @default(cuid())
  kindergartenId String
  /// Ключ в хранилище: schools/<kindergartenId>/<id>.
  key            String   @unique
  /// Исходное имя файла (для скачивания).
  name           String
  /// MIME по расширению (определяем сами, клиентскому не верим).
  mime           String
  /// Размер, байт.
  size           Int
  uploaderId     String?
  attached       Boolean  @default(false)
  createdAt      DateTime @default(now())

  kindergarten    Kindergarten     @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  uploader        User?            @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  libraryItems    LibraryItem[]
  lessonMaterials LessonMaterial[]

  @@index([kindergartenId])
  @@index([attached, createdAt])
}

/// Материал к уроку: учитель выкладывает файл / ссылку / текст для своего класса.
/// Живёт 30 дней (expiresAt), затем ночная чистка удаляет запись и файл.
model LessonMaterial {
  id             String   @id @default(cuid())
  kindergartenId String
  groupId        String
  subjectId      String?
  title          String
  description    String?
  url            String?
  fileId         String?
  authorId       String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject      Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  file         StoredFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  author       User?        @relation("LessonMaterialAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([groupId, expiresAt])
  @@index([expiresAt])
  @@index([kindergartenId])
}

/// Направление подготовки к экзамену. Название задаёт школа («ЕГЭ», «Вступительные»…).
model ExamTrack {
  id             String   @id @default(cuid())
  kindergartenId String
  name           String
  description    String?
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  author         User?        @relation("ExamTrackAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  quizzes        Quiz[]

  @@unique([kindergartenId, name])
}

enum QuestionKind {
  SINGLE    // один правильный ответ
  MULTIPLE  // несколько правильных: верно только при точном совпадении набора
}

model Quiz {
  id             String   @id @default(cuid())
  kindergartenId String
  title          String
  description    String?
  subjectId      String?
  /// Если квиз относится к подготовке к экзамену — направление.
  examTrackId    String?
  /// Лимит времени на прохождение, секунды (null — без лимита).
  timeLimitSec   Int?
  /// Ученики видят только опубликованные.
  isPublished    Boolean  @default(false)
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  examTrack      ExamTrack?   @relation(fields: [examTrackId], references: [id], onDelete: SetNull)
  author         User?        @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  questions      QuizQuestion[]
  attempts       QuizAttempt[]

  @@index([kindergartenId, isPublished])
  @@index([examTrackId])
}

model QuizQuestion {
  id          String       @id @default(cuid())
  quizId      String
  position    Int
  text        String
  kind        QuestionKind @default(SINGLE)
  /// [{ "text": "Вариант", "correct": true }, ...] — правильные ответы ученику не отдаются.
  options     Json
  explanation String?

  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, position])
}

/// Одна попытка ученика. Результат считает сервер и сохраняет как есть:
/// правка квиза позже не меняет прошлые оценки.
model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  score       Int
  total       Int
  /// [{ "questionId": "...", "selected": [0, 2] }, ...]
  answers     Json
  durationSec Int?
  createdAt   DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
  @@index([studentId, createdAt])
}

/// Результат мини-игры. Игры описаны в коде (server/src/modules/games/game-registry.ts).
model GameScore {
  id        String   @id @default(cuid())
  studentId String
  gameKey   String
  score     Int
  level     Int?
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([gameKey, score])
  @@index([studentId, gameKey])
}
