# ============================================================================
# KinderCRM Backend (NestJS) — пример .env. Скопируйте в .env и поменяйте секреты.
# ============================================================================

NODE_ENV=development
PORT=4000

# CORS — список разрешённых origin-ов через запятую
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://kg_user:kg_pass@localhost:5432/kg_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT (минимум 16 символов в проде, генерируйте через openssl rand -hex 64)
JWT_ACCESS_SECRET=replace-me-access-secret-min-16
JWT_REFRESH_SECRET=replace-me-refresh-secret-min-16
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Секрет подписи личных ссылок учеников (мин. 16 символов). Не задан — берётся производный от
# JWT_REFRESH_SECRET. Смена секрета гасит ВСЕ ссылки: их придётся выдать заново.
# STUDENT_LINK_SECRET=

# Throttling: limit запросов / ttl сек
THROTTLE_TTL=60
THROTTLE_LIMIT=120
# Сколько прокси перед сервером (на Railway — один; по умолчанию 1). Нужно, чтобы лимит запросов считался на каждого
# клиента по его настоящему адресу (X-Forwarded-For), а не на всех сразу как на адрес прокси.
# 0 или false — запуск без прокси (локально). true — доверять любым адресам: небезопасно.
# TRUST_PROXY=1

# Письма: приглашение директора и «Забыли пароль?» через Resend (HTTP API, не SMTP:
# Railway блокирует SMTP на тарифах Free/Trial/Hobby). Без ключа письма не отправляются:
# аккаунты создаются, а в интерфейсе видна причина и есть кнопка повторной отправки.
# Домен отправителя должен быть подтверждён в Resend (DNS-записи).
# RESEND_API_KEY=
# MAIL_FROM=Мактаби ман <no-reply@tahlilgar.cyou>
# APP_URL=https://tahlilgar.cyou

# Оповещения об ошибках сервера: письма на эти адреса (через запятую), когда запрос заканчивается ошибкой 5xx, база
# отвечает неожиданной ошибкой (например, не применена миграция) или упал процесс. Нужен RESEND_API_KEY. Пусто — выключено.
# Проверить можно кнопкой «Проверить оповещения» на странице «Школы» у владельца платформы.
# ALERT_EMAIL=owner@example.com

# Telegram (для уведомлений). Если пусто — TelegramProcessor просто логирует.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
