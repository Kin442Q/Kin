{
  "expo": {
    "name": "Мактаби ман",
    "slug": "maktabi-man",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE4D6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cyou.tahlilgar.maktabiman",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFE4D6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "cyou.tahlilgar.maktabiman",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0D7A7C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы прочитать QR-код с карточки ученика и войти без пароля.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "maktabiman",
    "owner": "qutbiddin",
    "extra": {
      "eas": {
        "projectId": "b20ef067-3d2a-4f49-8663-2005741e6f30"
      }
    }
  }
}
